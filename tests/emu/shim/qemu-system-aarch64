#!/bin/bash
# Stands in front of QEMU for QEngine's launcher (QEMU_BIN points here). Probes (-accel help, -device help, ...) pass straight through.
# A real launch (-kernel ...) is changed in three ways, so tests never write an instance's own disks and can snapshot the machine:
#   - every raw drive becomes a qcow2 overlay in $PM_OVERLAY_DIR backed by that image (made on first use);
#   - $PM_NETDEV_EXTRA is added to the user network (restrict=on, the fixture's guestfwd);
#   - $PM_QEMU_APPEND is added at the end (-loadvm <tag>).
real="${PM_QEMU_REAL:-/usr/bin/qemu-system-aarch64}"
case " $* " in *" -kernel "*) ;; *) exec "$real" "$@" ;; esac
[ -n "${PM_OVERLAY_DIR:-}" ] || exec "$real" "$@"
mkdir -p "$PM_OVERLAY_DIR"
args=()
while [ $# -gt 0 ]; do
    a=$1; shift
    case "$a" in
        if=none,file=*,format=raw,id=*)
            f=${a#if=none,file=}; f=${f%%,format=raw,id=*}; id=${a##*,id=}
            o="$PM_OVERLAY_DIR/$(basename "$f").qcow2"
            [ -f "$o" ] || qemu-img create -q -f qcow2 -b "$f" -F raw "$o" >&2
            a="if=none,file=$o,format=qcow2,id=$id" ;;
        user,id=net0,*) a="$a${PM_NETDEV_EXTRA:-}" ;;
    esac
    args+=("$a")
done
# The user drive: a disk of its own for the stand-in of the internal NVMe partition. It has to be a real block device: MPC asks its
# drive daemon (edisksd) what is attached, and that daemon tells it to ignore loop devices, so an image mounted with -o loop is no
# drive at all to MPC OS 3.10.1 (no "VST2 Plugins" scan, "Download directory could not be found"). Added first, so the instance's
# own disks keep their names; the guest finds it as /dev/disk/by-id/virtio-pmuser.
u="$PM_OVERLAY_DIR/user.qcow2"
[ -f "$u" ] || qemu-img create -q -f qcow2 "$u" "${PM_USER_DISK_SIZE:-4G}" >&2
# shellcheck disable=SC2086
exec "$real" -drive "if=none,file=$u,format=qcow2,id=pmuser" -device virtio-blk-device,drive=pmuser,serial=pmuser "${args[@]}" ${PM_QEMU_APPEND:-}
